<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="support_link">
    <inertial>
      <mass value="200"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="50"  ixy="0"  ixz="0" iyy="50" iyz="0" izz="50" />
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="1.38 0.85 0.88"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="1.38 0.85 0.88"/>
      </geometry>
    </collision>
  </link>

  <joint name="support_joint" type="fixed">
    <origin xyz="0.385 0 -1.44" rpy="0 0 0" />
    <parent link="base" />
    <child  link="support_link" />
  </joint>

</robot>
